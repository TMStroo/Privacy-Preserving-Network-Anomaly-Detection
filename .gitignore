# Data directories (never commit dataset files)
data/raw/
data/processed/
data/*.parquet
data/raw_sample/
# raw dataset cache used by the driftguard CLI when it is kept outside data/
driftguard_data/

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
ENV/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter notebook checkpoints
.ipynb_checkpoints/
*.ipynb_checkpoints

# Trained model binaries (regenerated by the pipeline, no reason to track)
results/models/
*.joblib
*.pkl
# per-experiment predictions are large row-level dumps; the metrics derived
# from them are tracked instead
results/experiments/**/predictions.parquet

# Metrics and figures ARE tracked: they are the evidence behind the README
# and the report. Dataset files stay out via the rules above.

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.tmp/
temp/

# Distribution / packaging
dist/
build/
*.egg-info/

# OS specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment files (if any)
.env
.env.localbench_unsw.log
bench_unsw.pid
results/superseded/
bench_unsw.log
bench_unsw.pid
bench_ugr.log
bench_ugr.pid
bench_all.log
bench_all.pid

# Per-row prediction tables are 100+ MB across all runs. The summary that says
# which run produced which number is tracked instead, in results/index.csv, so a
# reviewer can see the evidence without the bulk. Regenerate it with
# python tools/index_runs.py after any run.
results/experiments/**/predictions_*.csv
results/experiments/**/forward_windows_*.csv
results/index.csv

# The four runs the README and the report cite are tracked. Everything else under
# results/experiments is a smoke fixture, a superseded run or an interrupted
# attempt: useful on disk, cited by nothing, and not worth a repository entry.
# scripts/audit_experiments.py still inspects all of them.
results/experiments/*synthetic*/
results/experiments/*_1a0d5a/
results/experiments/*_f7e934/
results/experiments/*_88d8b4/
results/experiments/*_b421b0/
results/experiments/*_5484b2/
results/experiments/*_e6b598/

# The V1 pipeline's demo output, superseded by results/experiments.
results/demo/
